
# Main app domain
ONE_SERVER_URL=https://your-domain.com
BETTER_AUTH_URL=https://your-domain.com

VITE_WEB_HOSTNAME=your-domain.com

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# Admin document library (server only; development authentication)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me

# Cloudflare R2 / S3-compatible object storage
CLOUDFLARE_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-key
CLOUDFLARE_R2_BUCKET=panora-documents

# ============================================================================
# AUTHENTICATION
# ============================================================================

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-secret-key-here

# Panora chat (server only)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Generate independently with: openssl rand -hex 32
CHAT_QUOTA_SECRET=your-chat-quota-secret
